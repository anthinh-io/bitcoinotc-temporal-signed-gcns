{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.microsoft/usersecrets/**)",
      "Read(~/AppData/Roaming/Microsoft/UserSecrets/**)",
      "Read(**/secrets.json)",
      "Read(**/appsettings.Production.json)",
      "Read(**/appsettings.*.local.json)",
      "Read(**/local.settings.json)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*.snk)",
      "Read(~/.nuget/NuGet/NuGet.Config)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.netrc)",
      "Read(**/.git-credentials)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.tfvars)",
      "Read(**/terraform.tfstate*)",
      "Read(**/serviceAccountKey*.json)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Bash(dotnet user-secrets:*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(cat ~/.microsoft/usersecrets:*)",
      "Bash(cat ~/.aws:*)",
      "Bash(cat ~/.ssh:*)",
      "Bash(cat .env:*)",
      "Bash(type *UserSecrets*)"
    ]
  }
}
